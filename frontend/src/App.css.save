nano src/App.css/* GLOBAL */

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  background: #090909;
  color: #ffffff;
  font-family: Arial, Helvetica, sans-serif;
}

a {
  text-decoration: none;
  color: inherit;
}

:root {
  --gold: #d6ad60;
  --dark: #090909;
  --gray: #a5a5a5;
}

/* NAVBAR */

.navbar {
  height: 82px;
  padding: 0 8%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #090909;
  border-bottom: 1px solid #292929;
  position: sticky;
  top: 0;
  z-index: 100;
}

.logo {
  display: flex;
  align-items: center;
  gap: 10px;
  color: var(--gold);
  font-size: 21px;
  font-weight: bold;
  letter-spacing: 2px;
}

.logo strong {
  color: white;
}

.nav-links {
  display: flex;
  gap: 30px;
}

.nav-links a {
  color: #ddd;
  font-size: 13px;
  transition: 0.3s;
}

.nav-links a:hover {
  color: var(--gold);
}

.nav-book,
.gold-button {
  background: var(--gold);
  color: #090909;
  padding: 14px 22px;
  font-size: 13px;
  font-weight: bold;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  transition: 0.3s;
}

.nav-book:hover,
.gold-button:hover {
  background: white;
  transform: translateY(-2px);
}

.menu-toggle {
  display: none;
  color: white;
  background: none;
  border: none;
  cursor: pointer;
}

/* HERO */

.hero {
  min-height: 650px;
  position: relative;
  display: flex;
  align-items: center;
  padding: 90px 10%;
  background-image: url("https://images.unsplash.com/photo-1516035069371-29a1b244cc32?w=1920");
  background-size: cover;
  background-position: center;
}

.hero-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    90deg,
    rgba(0, 0, 0, 0.95),
    rgba(0, 0, 0, 0.65),
    rgba(0, 0, 0, 0.1)
  );
}

.hero-content {
  position: relative;
  z-index: 2;
  max-width: 650px;
}

.eyebrow,
.section-label {
  color: var(--gold);
  letter-spacing: 3px;
  font-size: 12px;
  font-weight: bold;
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 25px;
}

.hero h1 {
  font-size: clamp(48px, 7vw, 82px);
  line-height: 1.1;
  font-weight: 700;
  margin-bottom: 25px;
}

.hero h1 span,
.section h2 span,
.booking h2 span {
  color: var(--gold);
}

.hero-content > p {
  max-width: 480px;
  color: #ccc;
  line-height: 1.8;
  font-size: 15px;
}

.hero-buttons {
  display: flex;
  flex-wrap: wrap;
  gap: 15px;
  margin-top: 35px;
}

.outline-button {
  padding: 14px 22px;
  border: 1px solid #aaa;
  font-size: 13px;
  transition: 0.3s;
}

.outline-button:hover {
  border-color: var(--gold);
  color: var(--gold);
}

.hero-note {
  display: flex;
  gap: 12px;
  align-items: center;
  color: #bbb;
  font-size: 10px;
  letter-spacing: 2px;
  margin-top: 60px;
}

/* COMMON SECTION */

.section {
  padding: 100px 10%;
}

.section h2 {
  font-size: clamp(32px, 4vw, 48px);
  line-height: 1.3;
  margin-bottom: 25px;
}

/* ABOUT */

.about {
  text-align: center;
}

.about .section-label {
  justify-content: center;
}

.about > p {
  max-width: 700px;
  margin: 0 auto;
  color: var(--gray);
  line-height: 1.9;
}

.about-features {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 25px;
  margin-top: 65px;
}

.about-features > div {
  padding: 35px 20px;
  border: 1px solid #292929;
  transition: 0.3s;
}

.about-features > div:hover {
  border-color: var(--gold);
  transform: translateY(-5px);
}

.about-features svg {
  color: var(--gold);
  width: 30px;
  height: 30px;
  margin-bottom: 20px;
}

.about-features h3 {
  margin-bottom: 12px;
  font-size: 17px;
}

.about-features p {
  color: var(--gray);
  font-size: 13px;
  line-height: 1.7;
}

/* PORTFOLIO */

.portfolio {
  background: #101010;
}

.portfolio .section-label {
  margin-bottom: 15px;
}

.service-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 25px;
  margin-top: 45px;
}

.service-card {
  position: relative;
  height: 420px;
  overflow: hidden;
  background: #222;
}

.service-card img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.5s;
}

.service-card:hover img {
  transform: scale(1.08);
}

.service-card::after {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(
    transparent 30%,
    rgba(0, 0, 0, 0.9)
  );
}

.service-info {
  position: absolute;
  z-index: 2;
  bottom: 25px;
  left: 25px;
  right: 20px;
}

.service-info span {
  color: var(--gold);
  font-size: 10px;
  letter-spacing: 2px;
}

.service-info h3 {
  font-size: 21px;
  margin: 10px 0;
}

.service-info a {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-size: 13px;
}

/* BOOKING */

.booking {
  background: linear-gradient(
    rgba(0, 0, 0, 0.8),
    rgba(0, 0, 0, 0.9)
  ),
  url("https://images.unsplash.com/photo-1452587925148-ce544e77e70d?w=1920")
  center/cover;
  text-align: center;
}

.booking-content {
  max-width: 700px;
  margin: auto;
}

.booking .section-label {
  justify-content: center;
}

.booking-content > p {
  color: #ccc;
  margin-bottom: 30px;
  line-height: 1.8;
}

/* FOOTER */

.footer {
  background: #050505;
  padding: 55px 20px;
  text-align: center;
  border-top: 1px solid #292929;
}

.footer h2 {
  co.counter {
  font-size: 16px;
  padding: 5px 10px;
  border-radius: 5px;
  color: var(--accent);
  background: var(--accent-bg);
  border: 2px solid transparent;
  transition: border-color 0.3s;
  margin-bottom: 24px;

  &:hover {
    border-color: var(--accent-border);
  }
  &:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
}

.hero {
  position: relative;

  .base,
  .framework,
  .vite {
    inset-inline: 0;
    margin: 0 auto;
  }

  .base {
    width: 170px;
    position: relative;
    z-index: 0;
  }

  .framework,
  .vite {
    position: absolute;
  }

  .framework {
    z-index: 1;
    top: 34px;
    height: 28px;
    transform: perspective(2000px) rotateZ(300deg) rotateX(44deg) rotateY(39deg)
      scale(1.4);
  }

  .vite {
    z-index: 0;
    top: 107px;
    height: 26px;
    width: auto;
    transform: perspective(2000px) rotateZ(300deg) rotateX(40deg) rotateY(39deg)
      scale(0.8);
  }
}

#center {
  display: flex;
  flex-direction: column;
  gap: 25px;
  place-content: center;
  place-items: center;
  flex-grow: 1;

  @media (max-width: 1024px) {
    padding: 32px 20px 24px;
    gap: 18px;
  }
}

#next-steps {
  display: flex;
  border-top: 1px solid var(--border);
  text-align: left;

  & > div {
    flex: 1 1 0;
    padding: 32px;
    @media (max-width: 1024px) {
      padding: 24px 20px;
    }
  }

  .icon {
    margin-bottom: 16px;
    width: 22px;
    height: 22px;
  }

  @media (max-width: 1024px) {
    flex-direction: column;
    text-align: center;
  }
}

#docs {
  border-right: 1px solid var(--border);

  @media (max-width: 1024px) {
    border-right: none;
    border-bottom: 1px solid var(--border);
  }
}

#next-steps ul {
  list-style: none;
  padding: 0;
  display: flex;
  gap: 8px;
  margin: 32px 0 0;

  .logo {
    height: 18px;
  }

  a {
    color: var(--text-h);
    font-size: 16px;
    border-radius: 6px;
    background: var(--social-bg);
    display: flex;
    padding: 6px 12px;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    transition: box-shadow 0.3s;

    &:hover {
      box-shadow: var(--shadow);
    }
    .button-icon {
      height: 18px;
      width: 18px;
    }
  }

  @media (max-width: 1024px) {
    margin-top: 20px;
    flex-wrap: wrap;
    justify-content: center;

    li {
      flex: 1 1 calc(50% - 8px);
    }

    a {
      width: 100%;
      justify-content: center;
      box-sizing: border-box;
    }
  }
}

#spacer {
  height: 88px;
  border-top: 1px solid var(--border);
  @media (max-width: 1024px) {
    height: 48px;
  }
}

.ticks {
  position: relative;
  width: 100%;

  &::before,
  &::after {
    content: '';
    position: absolute;
    top: -4.5px;
    border: 5px solid transparent;
  }

  &::before {
    left: 0;
    border-left-color: var(--border);
  }
  &::after {
    right: 0;
    border-right-color: var(--border);
  }
}
